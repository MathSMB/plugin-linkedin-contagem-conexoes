{
  "manifest_version": 3,
  "name": "LinkedIn · Contagem de Conexões",
  "version": "1.6.1",
  "description": "Conta os convites de conexão que você envia no LinkedIn (hoje e últimos 7 dias) para manter um ritmo seguro.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["common.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn · Contagem de Conexões",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
